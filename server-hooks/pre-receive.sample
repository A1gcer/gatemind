#!/bin/bash
set -e
echo "[GateMind] pre-receive hook (sample)"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

while read oldrev newrev refname; do
    git archive "$newrev" | tar -x -C "$TMP_DIR"
    cd "$TMP_DIR"
    git init -q
    git add -A

    python3 -m skills.gatemind.cli run --phase pre_commit --from-git --enforce-exit || {
        echo "GateMind blocked push on $refname"
        exit 1
    }
done

exit 0
